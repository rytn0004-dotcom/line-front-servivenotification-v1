PORT=10000
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
TIMEZONE=Asia/Taipei
GOOGLE_API_MAX_RETRIES=4
SHEETS_SNAPSHOT_TTL_MS=15000
COURSE_SHEET_NAME=課表
COURSE_QUERY_MAX_ROWS=20

# Gemini AI 客服（Google AI Studio 免費方案可使用；未設定時 AI 客服停用）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_HISTORY_TURNS=6
AI_DAILY_REQUEST_LIMIT=30
AI_TOTAL_DAILY_LIMIT=300
# 可在 Render 直接覆寫客服人格；不要放敏感金鑰
# AI_SYSTEM_PROMPT=你是補習班 LINE 客服 AI，請用繁體中文親切回答。

# 安全綁定：一次性授權碼
BIND_AUTH_SHEET_NAME=綁定授權碼
BIND_CODE_MAX_ATTEMPTS=5
BIND_CODE_WINDOW_MS=600000
