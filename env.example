PORT=10000
TIMEZONE=Asia/Taipei

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini text / vision / PDF channels
GEMINI_API_KEY=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=
# Diagnostic mapping only; must match the Google Cloud Project attached to each key.
GEMINI_PROJECT_ID_A=gen-lang-client-0348350940
GEMINI_PROJECT_ID_B=gen-lang-client-0609456009
GEMINI_PROJECT_ID_C=gen-lang-client-0705859251
GEMINI_MODEL_ORDER=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_REQUEST_TIMEOUT_MS=90000
GEMINI_MODEL_COOLDOWN_MS=30000
GEMINI_MODEL_LONG_COOLDOWN_MS=600000
GEMINI_MODEL_QUOTA_COOLDOWN_MS=300000
GEMINI_503_COOLDOWN_MS=20000
AI_ENABLE_GOOGLE_SEARCH=true

# Optional cross-provider fallbacks for general text only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=
AI_PROVIDER_ORDER=gemini,openrouter,groq

# Free image generation via Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
IMAGE_GEN_DAILY_USER_LIMIT=2
IMAGE_GEN_DAILY_GLOBAL_LIMIT=20
IMAGE_GEN_CONCURRENCY=1
CLOUDFLARE_IMAGE_TIMEOUT_MS=90000
PUBLIC_BASE_URL=https://your-render-service.onrender.com
GENERATED_IMAGE_DIR=/tmp/line-customer-generated-images

# Cloudflare text fallback for AI客服 when Gemini is unavailable
CLOUDFLARE_TEXT_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_TEXT_MODEL_ORDER=@cf/google/gemma-4-26b-a4b-it,@cf/zai-org/glm-4.7-flash
CLOUDFLARE_TEXT_REJECT_IF_BUSY=true
CLOUDFLARE_TEXT_ENABLE_THINKING=false
CLOUDFLARE_TEXT_TIMEOUT_MS=60000
CLOUDFLARE_TEXT_OPENAI_FIRST=true
CLOUDFLARE_TEXT_EMPTY_COOLDOWN_MS=30000
ENABLE_CLOUDFLARE_TEXT_FALLBACK=true

# Optional robustness / tuning
AI_SYSTEM_PROMPT=
AI_PRIVATE_DATA_FALLBACK=false
AI_MAX_HISTORY_TURNS=6
AI_MEDIA_COMBINE_WINDOW_MS=60000
BIND_GRACE_MINUTES=3
INITIAL_REBIND_MAX=3
GOOGLE_API_MAX_RETRIES=4
SHEETS_SNAPSHOT_TTL_MS=12000
MEDIA_CONCURRENCY=1
MEDIA_UPLOAD_TEMP_DIR=/tmp/line-customer-media
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://line-customer-service.local
OPENROUTER_X_TITLE=LINE Customer Service AI
# Render automatically provides this in many deployments; PUBLIC_BASE_URL is preferred for generated image URLs.
RENDER_EXTERNAL_URL=

# 新鮮資訊搜尋失敗時，允許安全降級到一般 AI；一般 AI 不得捏造即時資訊。
AI_ALLOW_FRESH_DEGRADED_FALLBACK=true

# V2.9.0 路由 fail-open：路由只作訊號，不可因判斷失敗而封鎖 AI
AI_ROUTE_FAIL_OPEN=true
# Cloudflare 文字模型 REST 失敗時，額外嘗試 OpenAI-compatible endpoint
AI_CLOUDFLARE_OPENAI_FALLBACK=true
