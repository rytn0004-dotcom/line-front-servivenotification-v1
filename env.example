PORT=10000
TIMEZONE=Asia/Taipei

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini text / vision / PDF channels
GEMINI_API_KEY=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=
GEMINI_MODEL_ORDER=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MODEL_COOLDOWN_MS=30000
GEMINI_MODEL_LONG_COOLDOWN_MS=600000
AI_ENABLE_GOOGLE_SEARCH=true

# Optional cross-provider fallbacks for general text only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=
AI_PROVIDER_ORDER=gemini,openrouter,groq

# Free image generation via Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
IMAGE_GEN_DAILY_USER_LIMIT=2
IMAGE_GEN_DAILY_GLOBAL_LIMIT=20
IMAGE_GEN_CONCURRENCY=1
CLOUDFLARE_IMAGE_TIMEOUT_MS=90000
PUBLIC_BASE_URL=https://your-render-service.onrender.com
GENERATED_IMAGE_DIR=/tmp/line-customer-generated-images
