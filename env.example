PORT=10000
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
TIMEZONE=Asia/Taipei
GOOGLE_API_MAX_RETRIES=4
SHEETS_SNAPSHOT_TTL_MS=15000

# Gemini AI 客服（Google AI Studio 可使用 Gemini API；實際免費額度依 Google 當期方案與帳戶狀態）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MAX_HISTORY_TURNS=6
# 每日 AI 額度、輸入長度、輸出 Tokens、冷卻秒數與閒置分鐘數，請在 Google Sheet「系統設定」管理。
# AI 額度管理細項請在 Google Sheet「AI額度管理」管理。
# 可在 Render 直接覆寫客服人格；不要放敏感金鑰
# AI_SYSTEM_PROMPT=你是補習班 LINE 客服 AI，請用繁體中文親切回答。
