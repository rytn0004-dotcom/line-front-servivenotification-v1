# Required
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional text-AI fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=
AI_PROVIDER_ORDER=gemini,openrouter,groq

# Private student/course data must NOT be sent to fallback providers unless you have separately verified their data policies.
AI_PRIVATE_DATA_FALLBACK=false

# Media/resource controls (safe defaults; Google Sheet "系統設定" can override the first seven as noted in README)
AI_IMAGE_COST=2
AI_DOCUMENT_COST=3
AI_MAX_IMAGE_MB=8
AI_MAX_DOCUMENT_MB=10
AI_MAX_USER_MEDIA_MB=30
AI_MAX_GLOBAL_MEDIA_MB=300
MEDIA_CONCURRENCY=1

# Other AI controls
AI_MAX_HISTORY_TURNS=6
